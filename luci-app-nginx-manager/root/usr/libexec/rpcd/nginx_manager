		return
	}

	local diff_output=""
	if [ -d "${backup_path}/nginx/conf.d/luci-manager" ] && [ -d "${MANAGED_DIR}" ]; then
		diff_output="$(diff -ruN "${backup_path}/nginx/conf.d/luci-manager" "${MANAGED_DIR}" 2>/dev/null || true)"
	fi

	json_init
	json_add_string "diff" "${diff_output}"
	json_dump
