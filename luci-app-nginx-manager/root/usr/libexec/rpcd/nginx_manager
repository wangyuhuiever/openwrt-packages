handle_delete_cert() {
	local cert_id
	json_get_var cert_id "id"
	[ -z "${cert_id}" ] && { json_init; json_add_string "error" "missing id"; json_dump; return; }
	validate_uci_id "${cert_id}" || { json_init; json_add_string "error" "invalid id"; json_dump; return; }

	# Verify it's actually a cert section
	local section_type
	section_type="$(uci -q get "nginx_manager.${cert_id}")" || {
		json_init
		json_add_string "error" "cert not found"
		json_dump
		return
	}
	[ "${section_type}" != "cert" ] && {
		json_init
		json_add_string "error" "not a certificate"
		json_dump
		return
	}

	# If ACME cert, also clean up acme UCI config
	local cert_type
	cert_type="$(uci -q get "nginx_manager.${cert_id}.type")" || cert_type=""
	if [ "${cert_type}" = "acme" ]; then
		uci -q delete "acme.${cert_id}" 2>/dev/null
		uci -q commit acme
	fi

	# Remove cert directory
	load_global_config
	local cert_subdir="${CERT_DIR}/${cert_id}"
	if [ -d "${cert_subdir}" ]; then
		rm -rf "${cert_subdir}"
	fi

	# Clear ssl_cert references from any sites using this cert
	_DELETE_CERT_ID="${cert_id}"
	config_load nginx_manager
	config_foreach _clear_cert_reference site
	_DELETE_CERT_ID=""

	uci delete "nginx_manager.${cert_id}"

	uci commit nginx_manager

	# Clean up any ACME task status file
	rm -f "/tmp/acme-task-${cert_id}.json"

	# Regenerate nginx configs and reload
	run_apply_or_error || return

	json_init
	json_add_string "result" "ok"
	json_dump
}

_DELETE_CERT_ID=""
_clear_cert_reference() {
	local section="$1"
	local ssl_cert

	ssl_cert="$(uci -q get "nginx_manager.${section}.ssl_cert")" || ssl_cert=""
	[ "${ssl_cert}" = "${_DELETE_CERT_ID}" ] && uci -q delete "nginx_manager.${section}.ssl_cert"
}

handle_upload_cert() {
	local cert_name name cert_content key_content domain cert_id

	json_get_var cert_name "id"
	json_get_var name "name"
	json_get_var cert_content "cert_content"
	json_get_var key_content "key_content"
	json_get_var domain "domain"

	[ -z "${cert_name}" ] && { json_init; json_add_string "error" "missing id"; json_dump; return; }
	validate_name "${cert_name}" || { json_init; json_add_string "error" "invalid id"; json_dump; return; }
	resolve_new_cert_id "${cert_name}" || { json_init; json_add_string "error" "${_RESOLVE_CERT_ID_ERROR}"; json_dump; return; }
	cert_id="${_RESOLVED_CERT_ID}"
	[ -z "${cert_content}" ] && { json_init; json_add_string "error" "missing cert_content"; json_dump; return; }
	[ -z "${key_content}" ] && { json_init; json_add_string "error" "missing key_content"; json_dump; return; }

	load_global_config

	local cert_subdir="${CERT_DIR}/${cert_id}"
	mkdir -p "${cert_subdir}"
	chmod 700 "${cert_subdir}"

	printf '%s' "${cert_content}" > "${cert_subdir}/fullchain.pem"
	printf '%s' "${key_content}" > "${cert_subdir}/privkey.pem"
	chmod 600 "${cert_subdir}/privkey.pem"

	uci set "nginx_manager.${cert_id}=cert"
	uci set "nginx_manager.${cert_id}.name=${name:-${cert_name}}"
	uci set "nginx_manager.${cert_id}.type=manual"
	uci set "nginx_manager.${cert_id}.cert_path=${cert_subdir}/fullchain.pem"
	uci set "nginx_manager.${cert_id}.key_path=${cert_subdir}/privkey.pem"
	[ -n "${domain}" ] && uci set "nginx_manager.${cert_id}.domain=${domain}"
	uci set "nginx_manager.${cert_id}.auto_renew=0"
	uci commit nginx_manager

	json_init
	json_add_string "result" "ok"
	json_dump
}

handle_issue_self_signed() {
	local cert_name name domain cert_id

	json_get_var cert_name "id"
	json_get_var name "name"
	json_get_var domain "domain"

	[ -z "${cert_name}" ] && { json_init; json_add_string "error" "missing id"; json_dump; return; }
	validate_name "${cert_name}" || { json_init; json_add_string "error" "invalid id"; json_dump; return; }
	resolve_new_cert_id "${cert_name}" || { json_init; json_add_string "error" "${_RESOLVE_CERT_ID_ERROR}"; json_dump; return; }
	cert_id="${_RESOLVED_CERT_ID}"
	[ -z "${domain}" ] && { json_init; json_add_string "error" "missing domain"; json_dump; return; }

	load_global_config

	local cert_subdir="${CERT_DIR}/${cert_id}"
	mkdir -p "${cert_subdir}"
	chmod 700 "${cert_subdir}"

	openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
		-keyout "${cert_subdir}/privkey.pem" \
		-out "${cert_subdir}/fullchain.pem" \
		-subj "/CN=${domain}" 2>/dev/null

	[ $? -ne 0 ] && { json_init; json_add_string "error" "openssl failed"; json_dump; return; }

	chmod 600 "${cert_subdir}/privkey.pem"

	uci set "nginx_manager.${cert_id}=cert"
	uci set "nginx_manager.${cert_id}.name=${name:-${cert_name}}"
	uci set "nginx_manager.${cert_id}.type=self_signed"
	uci set "nginx_manager.${cert_id}.cert_path=${cert_subdir}/fullchain.pem"
	uci set "nginx_manager.${cert_id}.key_path=${cert_subdir}/privkey.pem"
	uci set "nginx_manager.${cert_id}.domain=${domain}"
	uci set "nginx_manager.${cert_id}.auto_renew=0"
	uci commit nginx_manager

	json_init
	json_add_string "result" "ok"
	json_dump
}

