# Write ACME task status to a temp file (atomic via rename)
_acme_task_write_status() {
	local cert_id="$1" status="$2" detail="${3:-}" command="${4:-}"
	local task_file="/tmp/acme-task-${cert_id}.json"
	local tmp_file="${task_file}.tmp"
	json_init
	json_add_string "status" "${status}"
	[ -n "${detail}" ] && json_add_string "detail" "${detail}"
	[ -n "${command}" ] && json_add_string "command" "${command}"
	json_dump > "${tmp_file}"
	mv "${tmp_file}" "${task_file}"
}

_acme_cert_set_status() {
	local cert_id="$1" status="$2" detail="${3:-}" command="${4:-}"
	local persistent_detail

	uci -q get "nginx_manager.${cert_id}" >/dev/null 2>&1 || return 0
	uci set "nginx_manager.${cert_id}.acme_status=${status}"
	uci set "nginx_manager.${cert_id}.acme_updated=$(date '+%Y-%m-%d %H:%M:%S')"

	if [ -n "${detail}" ]; then
		persistent_detail="$(printf '%s' "${detail}" | tr '\r\n' '  ' | cut -c 1-512)"
		uci set "nginx_manager.${cert_id}.acme_detail=${persistent_detail}"
	elif [ "${status}" = "running" ] || [ "${status}" = "success" ]; then
		uci -q delete "nginx_manager.${cert_id}.acme_detail" 2>/dev/null
	fi

	[ -n "${command}" ] && uci set "nginx_manager.${cert_id}.acme_command=${command}"
	uci commit nginx_manager
}

# Check if an ACME task is already running for the given cert_id
_acme_task_is_running() {
	local cert_id="$1"
	local task_file="/tmp/acme-task-${cert_id}.json"
	[ -f "${task_file}" ] && grep -q '"running"' "${task_file}"
}

ACME_ACCOUNT_EMAIL=""
ACME_ACCOUNT_SECTION_COUNT=0

_acme_set_account_section() {
	local section="$1"
	uci set "acme.${section}.account_email=${ACME_ACCOUNT_EMAIL}"
	uci -q get "acme.${section}.debug" >/dev/null 2>&1 || uci set "acme.${section}.debug=0"
	ACME_ACCOUNT_SECTION_COUNT=$((ACME_ACCOUNT_SECTION_COUNT + 1))
}

ensure_acme_account_config() {
	local account_email="$1"

	ACME_ACCOUNT_EMAIL="${account_email}"
	ACME_ACCOUNT_SECTION_COUNT=0
	config_load acme
	config_foreach _acme_set_account_section acme

	if [ "${ACME_ACCOUNT_SECTION_COUNT}" -eq 0 ]; then
		uci set acme.acme=acme
		uci set "acme.acme.account_email=${account_email}"
		uci set acme.acme.debug='0'
	fi

	uci commit acme
}

_acme_build_issue_cmd() {
	local domain="$1" account_email="$2" validation_method="$3" dns_api="$4" dns_wait="$5" keylength="$6"
	[ -z "${keylength}" ] && keylength="ec-256"
	case "${keylength}" in
		ec256|ec-256) keylength="ec-256" ;;
		ec384|ec-384) keylength="ec-384" ;;
		rsa2048|2048) keylength="2048" ;;
		rsa4096|4096) keylength="4096" ;;
	esac
	local cmd="acme.sh --issue -d ${domain} --keylength ${keylength} --server letsencrypt"
	[ -n "${account_email}" ] && cmd="${cmd} --accountemail ${account_email}"
	case "${validation_method}" in
		dns)
			[ -n "${dns_api}" ] && cmd="${cmd} --dns ${dns_api}"
			[ -n "${dns_wait}" ] && cmd="${cmd} --dnssleep ${dns_wait}"
			;;
		webroot)
			cmd="${cmd} --webroot /var/run/acme/challenge"
			;;
		standalone)
			cmd="${cmd} --standalone --listen-v6 --httpport 80"
			;;
	esac
	echo "${cmd}"
}

_acme_build_renew_cmd() {
	local domain="$1" validation_method="$2" dns_api="$3" dns_wait="$4" keylength="$5"
	local ecc_flag="--ecc"
	case "${keylength}" in
		rsa2048|2048|rsa4096|4096) ecc_flag="" ;;
	esac
	local cmd="acme.sh --renew -d ${domain}"
	[ -n "${ecc_flag}" ] && cmd="${cmd} ${ecc_flag}"
	case "${validation_method}" in
		dns)
			[ -n "${dns_api}" ] && cmd="${cmd} --dns ${dns_api}"
			[ -n "${dns_wait}" ] && cmd="${cmd} --dnssleep ${dns_wait}"
			;;
		webroot)
			cmd="${cmd} --webroot /var/run/acme/challenge"
			;;
		standalone)
			cmd="${cmd} --standalone --listen-v6 --httpport 80"
			;;
	esac
	echo "${cmd}"
}

_acme_record_config() {
	local cert_id="$1" cert_name="$2" domain="$3" cert_dir="$4" validation_method="$5" dns_api="$6" status="$7" auto_renew="${8:-1}" dns_wait="${9:-}" email="${10:-}" keylength="${11:-ec-256}"
	local cert_subdir="${cert_dir}/${cert_id}"

	uci set "nginx_manager.${cert_id}=cert"
	uci set "nginx_manager.${cert_id}.name=${cert_name}"
	uci set "nginx_manager.${cert_id}.type=acme"
	uci set "nginx_manager.${cert_id}.cert_path=${cert_subdir}/fullchain.pem"
	uci set "nginx_manager.${cert_id}.key_path=${cert_subdir}/privkey.pem"
	uci set "nginx_manager.${cert_id}.domain=${domain}"
	uci set "nginx_manager.${cert_id}.auto_renew=${auto_renew}"
	[ -z "${keylength}" ] && keylength="ec-256"
	uci set "nginx_manager.${cert_id}.keylength=${keylength}"
	[ -z "${email}" ] && email="$(_get_acme_account_email "${cert_id}")"
	[ -n "${email}" ] && uci set "nginx_manager.${cert_id}.account_email=${email}"
	uci set "nginx_manager.${cert_id}.validation_method=${validation_method}"
	if [ "${validation_method}" = "dns" ]; then
		uci set "nginx_manager.${cert_id}.dns_api=${dns_api}"
		if [ -n "${dns_wait}" ]; then
			uci set "nginx_manager.${cert_id}.dns_wait=${dns_wait}"
		else
			uci -q delete "nginx_manager.${cert_id}.dns_wait" 2>/dev/null
		fi
	else
		uci -q delete "nginx_manager.${cert_id}.dns_api" 2>/dev/null
		uci -q delete "nginx_manager.${cert_id}.dns_wait" 2>/dev/null
	fi
	uci set "nginx_manager.${cert_id}.acme_status=${status}"
	local acme_cmd="$(_acme_build_issue_cmd "${domain}" "${email}" "${validation_method}" "${dns_api}" "${dns_wait}" "${keylength}")"
	uci set "nginx_manager.${cert_id}.acme_command=${acme_cmd}"
	uci -q delete "nginx_manager.${cert_id}.acme_detail" 2>/dev/null
	uci commit nginx_manager
}

_acme_recent_log() {
	local task_id="$1"
	if [ -n "${task_id}" ]; then
		if [ -f "/tmp/acme-task-${task_id}.log" ]; then
			tail -n 120 "/tmp/acme-task-${task_id}.log"
			return
		elif [ -f "/tmp/acme-task-cert_${task_id}.log" ]; then
			tail -n 120 "/tmp/acme-task-cert_${task_id}.log"
			return
		fi
	fi
	logread -e acme 2>/dev/null | tail -n 80
}

_cleanup_acme_ssl_links() {
	local domain="$1"
	local f
	for f in "${domain}.crt" "${domain}.key" "${domain}.fullchain.crt" "${domain}.combined.crt" "${domain}.chain.crt"; do
		[ -L "/etc/ssl/acme/${f}" ] && rm -f "/etc/ssl/acme/${f}"
	done
}

_acme_exec_issue() {
	local cert_id="$1" cert_name="$2" domain="$3" cert_dir="$4" validation_method="$5" dns_api="$6" auto_renew="$7" dns_wait="$8" account_email="$9" keylength="${10:-ec-256}"
	local log_file="/tmp/acme-task-${cert_id}.log"
	mkdir -p "$(dirname "${log_file}")" /etc/acme /etc/ssl/acme /var/run/acme/challenge
	: > "${log_file}"

	[ -z "${account_email}" ] && account_email="$(_get_acme_account_email "${cert_id}")"
	[ -z "${account_email}" ] && account_email="admin@${domain}"
	[ -z "${keylength}" ] && keylength="$(uci -q get "nginx_manager.${cert_id}.keylength")"
	[ -z "${keylength}" ] && keylength="ec-256"

	local keylength_arg="ec-256"
	case "${keylength}" in
		ec256|ec-256) keylength_arg="ec-256" ;;
		ec384|ec-384) keylength_arg="ec-384" ;;
		rsa2048|2048) keylength_arg="2048" ;;
		rsa4096|4096) keylength_arg="4096" ;;
	esac

	# Remove old symlinks if any
	_cleanup_acme_ssl_links "${domain}"

	# Determine acme section name
	local acme_sec="${cert_id}"
	uci -q get "acme.${acme_sec}" >/dev/null 2>&1 || acme_sec="$(_find_acme_section_for_domain "${domain}" "${cert_id}")"

	(
		export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
		export NO_TIMESTAMP=1

		# Load credentials
		if [ -n "${acme_sec}" ] && uci -q get "acme.${acme_sec}" >/dev/null 2>&1; then
			local cred_list
			cred_list="$(uci -q get "acme.${acme_sec}.credentials")"
			if [ -n "${cred_list}" ]; then
				local IFS_OLD="${IFS}"
				IFS='
'
				for cred_line in ${cred_list}; do
					cred_line="$(printf '%s' "${cred_line}" | tr -d '\r')"
					[ -n "${cred_line}" ] && eval "export ${cred_line}"
				done
				IFS="${IFS_OLD}"
			fi
		fi

		local cmd="/usr/lib/acme/client/acme.sh"
		[ ! -x "${cmd}" ] && cmd="acme.sh"

		set -- "${cmd}" --issue \
			--home /etc/acme \
			--keylength "${keylength_arg}" \
			--accountemail "${account_email}" \
			--server letsencrypt \
			-d "${domain}" \
			--force

		case "${validation_method}" in
			dns)
				set -- "$@" --dns "${dns_api}"
				[ -n "${dns_wait}" ] && set -- "$@" --dnssleep "${dns_wait}"
				;;
			webroot)
				mkdir -p /var/run/acme/challenge
				set -- "$@" --webroot /var/run/acme/challenge
				;;
			standalone)
				set -- "$@" --standalone --listen-v6 --httpport 80
				;;
		esac

		"$@"
	) >> "${log_file}" 2>&1
	local exit_code=$?

	return ${exit_code}
}

_acme_exec_renew() {
	local cert_id="$1" domain="$2" keylength="$3"
	local log_file="/tmp/acme-task-${cert_id}.log"
	mkdir -p "$(dirname "${log_file}")" /etc/acme /etc/ssl/acme
	: > "${log_file}"

	[ -z "${keylength}" ] && keylength="$(uci -q get "nginx_manager.${cert_id}.keylength")"
	local ecc_arg="--ecc"
	case "${keylength}" in
		rsa2048|2048|rsa4096|4096) ecc_arg="" ;;
	esac

	local acme_sec="${cert_id}"
	uci -q get "acme.${acme_sec}" >/dev/null 2>&1 || acme_sec="$(_find_acme_section_for_domain "${domain}" "${cert_id}")"

	(
		export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
		export NO_TIMESTAMP=1

		# Load credentials
		if [ -n "${acme_sec}" ] && uci -q get "acme.${acme_sec}" >/dev/null 2>&1; then
			local cred_list
			cred_list="$(uci -q get "acme.${acme_sec}.credentials")"
			if [ -n "${cred_list}" ]; then
				local IFS_OLD="${IFS}"
				IFS='
'
				for cred_line in ${cred_list}; do
					cred_line="$(printf '%s' "${cred_line}" | tr -d '\r')"
					[ -n "${cred_line}" ] && eval "export ${cred_line}"
				done
				IFS="${IFS_OLD}"
			fi
		fi

		local cmd="/usr/lib/acme/client/acme.sh"
		[ ! -x "${cmd}" ] && cmd="acme.sh"

		set -- "${cmd}" --renew \
			--home /etc/acme \
			-d "${domain}" \
			--force
		[ -n "${ecc_arg}" ] && set -- "$@" "${ecc_arg}"

		"$@"
	) >> "${log_file}" 2>&1
	local exit_code=$?

	return ${exit_code}
}

_acme_install_cert_files() {
	local cert_id="$1" domain="$2" cert_dir="$3"
	local domain_dir="/etc/acme/${domain}_ecc"
	[ -d "${domain_dir}" ] || domain_dir="/etc/acme/${domain}"

	if [ ! -f "${domain_dir}/fullchain.cer" ] || [ ! -f "${domain_dir}/${domain}.key" ]; then
		# Fallback search common directories
		local _sd _sub
		for _sd in /etc/acme /.acme.sh /root/.acme.sh; do
			for _sub in "${_sd}/${domain}_ecc" "${_sd}/${domain}"; do
				if [ -f "${_sub}/fullchain.cer" ] && [ -f "${_sub}/${domain}.key" ]; then
					domain_dir="${_sub}"
					break 2
				fi
			done
		done
	fi

	[ -f "${domain_dir}/fullchain.cer" ] || return 1
	[ -f "${domain_dir}/${domain}.key" ] || return 1

	# 1. OpenWrt standard paths in /etc/ssl/acme/
	mkdir -p /etc/ssl/acme
	(
		umask 077
		cat "${domain_dir}/fullchain.cer" "${domain_dir}/${domain}.key" > "${domain_dir}/combined.cer"
	) 2>/dev/null
	ln -sf "${domain_dir}/${domain}.cer" "/etc/ssl/acme/${domain}.crt" 2>/dev/null
	ln -sf "${domain_dir}/${domain}.key" "/etc/ssl/acme/${domain}.key" 2>/dev/null
	ln -sf "${domain_dir}/fullchain.cer" "/etc/ssl/acme/${domain}.fullchain.crt" 2>/dev/null
	ln -sf "${domain_dir}/combined.cer" "/etc/ssl/acme/${domain}.combined.crt" 2>/dev/null
	[ -f "${domain_dir}/ca.cer" ] && ln -sf "${domain_dir}/ca.cer" "/etc/ssl/acme/${domain}.chain.crt" 2>/dev/null

	# 2. Nginx Manager isolated certificate directory
	local cert_subdir="${cert_dir}/${cert_id}"
	mkdir -p "${cert_subdir}"
	chmod 700 "${cert_subdir}"
	ln -sf "/etc/ssl/acme/${domain}.fullchain.crt" "${cert_subdir}/fullchain.pem"
	ln -sf "/etc/ssl/acme/${domain}.key" "${cert_subdir}/privkey.pem"

	return 0
}

# Background worker for ACME issue
_acme_issue_worker() {
	local cert_id="$1" cert_name="$2" domain="$3" cert_dir="$4" validation_method="$5" dns_api="$6" auto_renew="$7" dns_wait="$8" account_email="$9" keylength="${10:-ec-256}"
	local log_file="/tmp/acme-task-${cert_id}.log"

	[ -z "${account_email}" ] && account_email="$(_get_acme_account_email "${cert_id}")"
	[ -z "${keylength}" ] && keylength="$(uci -q get "nginx_manager.${cert_id}.keylength")"
	[ -z "${keylength}" ] && keylength="ec-256"
	local acme_cmd="$(_acme_build_issue_cmd "${domain}" "${account_email}" "${validation_method}" "${dns_api}" "${dns_wait}" "${keylength}")"

	_acme_task_write_status "${cert_id}" "running" "Starting ACME certificate issuance..." "${acme_cmd}"

	if [ "${validation_method}" = "webroot" ]; then
		prepare_acme_challenge_config "${cert_id}" "${domain}" >/dev/null 2>&1
	fi

	_acme_exec_issue "${cert_id}" "${cert_name}" "${domain}" "${cert_dir}" "${validation_method}" "${dns_api}" "${auto_renew}" "${dns_wait}" "${account_email}" "${keylength}"
	local exec_exit=$?

	[ "${validation_method}" = "webroot" ] && cleanup_acme_challenge_config "${cert_id}"

	if ! _acme_install_cert_files "${cert_id}" "${domain}" "${cert_dir}"; then
		local err_msg="ACME certificate issuance failed; see task log for details"
		[ -f "${log_file}" ] && err_msg="$(tail -n 5 "${log_file}" | tr '\n' ' ')"
		_acme_cert_set_status "${cert_id}" "failed" "${err_msg}" "${acme_cmd}"
		_acme_task_write_status "${cert_id}" "failed" "${err_msg}" "${acme_cmd}"
		return
	fi

	_acme_record_config "${cert_id}" "${cert_name}" "${domain}" "${cert_dir}" "${validation_method}" "${dns_api}" "success" "${auto_renew}" "${dns_wait}" "${account_email}" "${keylength}"
	_acme_cert_set_status "${cert_id}" "success" "" "${acme_cmd}"
	uci -q delete "nginx_manager.${cert_id}.acme_detail" 2>/dev/null
	uci commit nginx_manager

	# Reload nginx to pick up the new certificate
	/etc/init.d/nginx reload >/dev/null 2>&1

	_acme_task_write_status "${cert_id}" "success" "Certificate successfully issued and activated" "${acme_cmd}"
}

# Background worker for ACME renew
_acme_renew_worker() {
	local cert_id="$1" domain="$2" validation_method="$3" auto_renew="$4"
	local log_file="/tmp/acme-task-${cert_id}.log"

	local cert_name dns_api dns_wait account_email keylength
	cert_name="$(uci -q get "nginx_manager.${cert_id}.name")" || cert_name="${cert_id}"
	dns_api="$(uci -q get "nginx_manager.${cert_id}.dns_api")" || dns_api=""
	dns_wait="$(uci -q get "nginx_manager.${cert_id}.dns_wait")" || dns_wait=""
	keylength="$(uci -q get "nginx_manager.${cert_id}.keylength")" || keylength="ec-256"
	account_email="$(_get_acme_account_email "${cert_id}")"

	local acme_cmd="$(_acme_build_renew_cmd "${domain}" "${validation_method}" "${dns_api}" "${dns_wait}" "${keylength}")"

	_acme_task_write_status "${cert_id}" "running" "Starting ACME certificate renewal..." "${acme_cmd}"

	if [ "${validation_method}" = "webroot" ]; then
		prepare_acme_challenge_config "${cert_id}" "${domain}" >/dev/null 2>&1
	fi

	_acme_exec_renew "${cert_id}" "${domain}" "${keylength}"
	local renew_exit=$?

	# If renew failed (e.g. config changed), fall back to exec_issue
	if [ ${renew_exit} -ne 0 ]; then
		_acme_exec_issue "${cert_id}" "${cert_name}" "${domain}" "${CERT_DIR}" "${validation_method}" "${dns_api}" "${auto_renew}" "${dns_wait}" "${account_email}" "${keylength}"
	fi

	[ "${validation_method}" = "webroot" ] && cleanup_acme_challenge_config "${cert_id}"

	if ! _acme_install_cert_files "${cert_id}" "${domain}" "${CERT_DIR}"; then
		local err_msg="ACME renewal failed; see task log for details"
		[ -f "${log_file}" ] && err_msg="$(tail -n 5 "${log_file}" | tr '\n' ' ')"
		_acme_cert_set_status "${cert_id}" "failed" "${err_msg}" "${acme_cmd}"
		_acme_task_write_status "${cert_id}" "failed" "${err_msg}" "${acme_cmd}"
		return
	fi

	_acme_cert_set_status "${cert_id}" "success" "" "${acme_cmd}"
	uci -q delete "nginx_manager.${cert_id}.acme_detail" 2>/dev/null
	uci commit nginx_manager

	# Reload nginx to pick up the renewed certificate
	/etc/init.d/nginx reload >/dev/null 2>&1

	_acme_task_write_status "${cert_id}" "success" "Certificate successfully renewed and activated" "${acme_cmd}"
}

handle_acme_issue() {
	local cert_name domain account_email validation_method dns_api credentials dns_wait auto_renew keylength cert_id

	json_get_var cert_name "id"
	json_get_var domain "domain"
	json_get_var account_email "account_email"
	json_get_var validation_method "validation_method"
	json_get_var dns_api "dns_api"
	json_get_var credentials "credentials"
	json_get_var dns_wait "dns_wait"
	json_get_var auto_renew "auto_renew"
	json_get_var keylength "keylength"
	[ -z "${keylength}" ] && keylength="ec-256"

	[ -z "${cert_name}" ] && { json_init; json_add_string "error" "missing id"; json_dump; return; }
	validate_name "${cert_name}" || { json_init; json_add_string "error" "invalid id"; json_dump; return; }
	[ -z "${domain}" ] && { json_init; json_add_string "error" "missing domain"; json_dump; return; }
	validate_domain "${domain}" || { json_init; json_add_string "error" "invalid domain"; json_dump; return; }
	[ -z "${account_email}" ] && { json_init; json_add_string "error" "missing acme account email"; json_dump; return; }
	validate_acme_account_email "${account_email}" || { json_init; json_add_string "error" "invalid acme account email"; json_dump; return; }
	[ -z "${validation_method}" ] && validation_method="webroot"
	case "${validation_method}" in
		webroot|dns|standalone) ;;
		*) { json_init; json_add_string "error" "invalid acme validation method"; json_dump; return; } ;;
	esac
	if { [ "${validation_method}" = "webroot" ] || [ "${validation_method}" = "standalone" ]; } && echo "${domain}" | grep -q '\*'; then
		json_init; json_add_string "error" "wildcard domains not supported for http acme"; json_dump; return
	fi
	if [ "${validation_method}" = "dns" ]; then
		[ -n "${dns_api}" ] || { json_init; json_add_string "error" "missing dns api"; json_dump; return; }
		validate_acme_dns_api "${dns_api}" || { json_init; json_add_string "error" "invalid dns api"; json_dump; return; }
		[ -n "${credentials}" ] || { json_init; json_add_string "error" "missing dns credentials"; json_dump; return; }
		if [ ! -d /usr/lib/acme/dnsapi ] && [ ! -d /usr/lib/acme/client/dnsapi ]; then
			json_init; json_add_string "error" "acme dns api package not installed"; json_dump; return;
		fi
		printf '%s\n' "${credentials}" | while IFS= read -r credential_line; do
			credential_line="$(printf '%s' "${credential_line}" | tr -d '\r')"
			[ -z "${credential_line}" ] && continue
			validate_acme_credential "${credential_line}" || exit 1
		done || { json_init; json_add_string "error" "invalid dns credentials"; json_dump; return; }
	fi
	if [ -n "${dns_wait}" ]; then
		validate_positive_number "${dns_wait}" || { json_init; json_add_string "error" "invalid dns wait seconds"; json_dump; return; }
	fi
	[ -z "${auto_renew}" ] && auto_renew="1"
	case "${auto_renew}" in
		0|1) ;;
		*) { json_init; json_add_string "error" "invalid auto renew"; json_dump; return; } ;;
	esac

	# Check for duplicate cert_id
	resolve_new_cert_id "${cert_name}" || { json_init; json_add_string "error" "${_RESOLVE_CERT_ID_ERROR}"; json_dump; return; }
	cert_id="${_RESOLVED_CERT_ID}"

	# Prevent concurrent ACME operations for the same cert
	_acme_task_is_running "${cert_id}" && {
		json_init; json_add_string "error" "ACME operation already in progress for this certificate"; json_dump; return
	}

	# Check if acme package is installed
	if [ ! -x /etc/init.d/acme ]; then
		json_init
		json_add_string "error" "acme package not installed"
		json_dump
		return
	fi

	load_global_config

	# Create UCI config in /etc/config/acme
	ensure_acme_account_config "${account_email}"

	# Create cert section in acme config
	uci set "acme.${cert_id}=cert"
	uci set "acme.${cert_id}.enabled=1"
	uci set "acme.${cert_id}.validation_method=${validation_method}"
	local acme_key_type="ec256"
	case "${keylength}" in
		ec384|ec-384) acme_key_type="ec384" ;;
		rsa2048|2048) acme_key_type="rsa2048" ;;
		rsa4096|4096) acme_key_type="rsa4096" ;;
		*) acme_key_type="ec256" ;;
	esac
	uci set "acme.${cert_id}.key_type=${acme_key_type}"
	uci -q delete "acme.${cert_id}.dns" 2>/dev/null
	uci -q delete "acme.${cert_id}.credentials" 2>/dev/null
	uci -q delete "acme.${cert_id}.dns_wait" 2>/dev/null
	if [ "${validation_method}" = "dns" ]; then
		uci set "acme.${cert_id}.dns=${dns_api}"
		printf '%s\n' "${credentials}" | while IFS= read -r credential_line; do
			credential_line="$(printf '%s' "${credential_line}" | tr -d '\r')"
			[ -z "${credential_line}" ] && continue
			uci add_list "acme.${cert_id}.credentials=${credential_line}"
		done
		[ -n "${dns_wait}" ] && uci set "acme.${cert_id}.dns_wait=${dns_wait}"
	fi
	uci delete "acme.${cert_id}.domains" 2>/dev/null
	uci add_list "acme.${cert_id}.domains=${domain}"
	uci commit acme

	local acme_cmd="$(_acme_build_issue_cmd "${domain}" "${account_email}" "${validation_method}" "${dns_api}" "${dns_wait}" "${keylength}")"
	_acme_record_config "${cert_id}" "${cert_name}" "${domain}" "${CERT_DIR}" "${validation_method}" "${dns_api}" "running" "${auto_renew}" "${dns_wait}" "${account_email}" "${keylength}"
	_acme_task_write_status "${cert_id}" "running" "ACME request queued" "${acme_cmd}"

	if [ "${validation_method}" = "webroot" ]; then
		local challenge_output
		challenge_output="$(prepare_acme_challenge_config "${cert_id}" "${domain}" 2>&1)"
		if [ $? -ne 0 ]; then
			_acme_restore_enabled "${cert_id}" "${auto_renew}"
			_acme_cert_set_status "${cert_id}" "failed" "${challenge_output}" "${acme_cmd}"
			_acme_task_write_status "${cert_id}" "failed" "${challenge_output}" "${acme_cmd}"

			json_init
			json_add_string "task_id" "${cert_id}"
			json_add_string "status" "failed"
			json_dump
			return
		fi
	fi

	# Write initial status and spawn background worker
	_acme_cert_set_status "${cert_id}" "running" "" "${acme_cmd}"
	_acme_task_write_status "${cert_id}" "running" "ACME is running in the background" "${acme_cmd}"
	(_acme_issue_worker "${cert_id}" "${cert_name}" "${domain}" "${CERT_DIR}" "${validation_method}" "${dns_api}" "${auto_renew}" "${dns_wait}" "${account_email}" "${keylength}" &)

	json_init
	json_add_string "task_id" "${cert_id}"
	json_add_string "status" "running"
	json_dump
}

handle_acme_update() {
	local cert_id domain account_email validation_method dns_api credentials dns_wait auto_renew keylength

	json_get_var cert_id "id"
	json_get_var domain "domain"
	json_get_var account_email "account_email"
	json_get_var validation_method "validation_method"
	json_get_var dns_api "dns_api"
	json_get_var credentials "credentials"
	json_get_var dns_wait "dns_wait"
	json_get_var auto_renew "auto_renew"
	json_get_var keylength "keylength"

	[ -z "${cert_id}" ] && { json_init; json_add_string "error" "missing id"; json_dump; return; }
	validate_uci_id "${cert_id}" || { json_init; json_add_string "error" "invalid id"; json_dump; return; }

	# Verify cert exists and is acme type
	local cert_type
	cert_type="$(uci -q get "nginx_manager.${cert_id}.type")" || {
		json_init; json_add_string "error" "cert not found"; json_dump; return
	}
	[ "${cert_type}" = "acme" ] || {
		json_init; json_add_string "error" "not an acme certificate"; json_dump; return
	}

	# Validate provided fields
	[ -n "${domain}" ] && { validate_domain "${domain}" || { json_init; json_add_string "error" "invalid domain"; json_dump; return; }; }
	[ -n "${account_email}" ] && { validate_acme_account_email "${account_email}" || { json_init; json_add_string "error" "invalid acme account email"; json_dump; return; }; }
	if [ -n "${validation_method}" ]; then
		case "${validation_method}" in
			webroot|dns|standalone) ;;
			*) { json_init; json_add_string "error" "invalid acme validation method"; json_dump; return; } ;;
		esac
	fi
	if [ -n "${auto_renew}" ]; then
		case "${auto_renew}" in
			0|1) ;;
			*) { json_init; json_add_string "error" "invalid auto renew"; json_dump; return; } ;;
		esac
	fi

	# Read current values
	local cur_domain cur_validation_method cur_dns_api cur_auto_renew cur_dns_wait cur_account_email cur_keylength
	cur_domain="$(uci -q get "nginx_manager.${cert_id}.domain")" || cur_domain=""
	cur_validation_method="$(uci -q get "nginx_manager.${cert_id}.validation_method")" || cur_validation_method="webroot"
	cur_dns_api="$(uci -q get "nginx_manager.${cert_id}.dns_api")" || cur_dns_api=""
	cur_auto_renew="$(uci -q get "nginx_manager.${cert_id}.auto_renew")" || cur_auto_renew="1"
	cur_dns_wait="$(uci -q get "nginx_manager.${cert_id}.dns_wait")" || cur_dns_wait=""
	cur_account_email="$(_get_acme_account_email "${cert_id}")"
	cur_keylength="$(uci -q get "nginx_manager.${cert_id}.keylength")" || cur_keylength="ec-256"

	# Apply new values (fall back to current if not provided)
	local new_domain new_validation_method new_dns_api new_auto_renew new_dns_wait new_account_email new_keylength
	new_domain="${domain:-${cur_domain}}"
	new_validation_method="${validation_method:-${cur_validation_method}}"
	new_dns_api="${dns_api:-${cur_dns_api}}"
	new_auto_renew="${auto_renew:-${cur_auto_renew}}"
	new_dns_wait="${dns_wait:-${cur_dns_wait}}"
	new_account_email="${account_email:-${cur_account_email}}"
	new_keylength="${keylength:-${cur_keylength}}"

	# Validate DNS-specific fields with resolved values
	if [ "${new_validation_method}" = "dns" ]; then
		[ -n "${new_dns_api}" ] || { json_init; json_add_string "error" "missing dns api"; json_dump; return; }
		validate_acme_dns_api "${new_dns_api}" || { json_init; json_add_string "error" "invalid dns api"; json_dump; return; }
	fi
	# Wildcard check for non-DNS methods
	if [ "${new_validation_method}" != "dns" ] && echo "${new_domain}" | grep -q '\*'; then
		json_init; json_add_string "error" "wildcard domains not supported for http acme"; json_dump; return
	fi
	if [ -n "${new_dns_wait}" ]; then
		validate_positive_number "${new_dns_wait}" || { json_init; json_add_string "error" "invalid dns wait seconds"; json_dump; return; }
	fi

	# Determine if re-issue is needed (domain, validation_method, dns_api, keylength changed)
	local needs_reissue="0"
	[ "${new_domain}" != "${cur_domain}" ] && needs_reissue="1"
	[ "${new_validation_method}" != "${cur_validation_method}" ] && needs_reissue="1"
	[ "${new_validation_method}" = "dns" ] && [ "${new_dns_api}" != "${cur_dns_api}" ] && needs_reissue="1"
	[ "${new_keylength}" != "${cur_keylength}" ] && needs_reissue="1"

	# Update nginx_manager UCI
	uci set "nginx_manager.${cert_id}.domain=${new_domain}"
	uci set "nginx_manager.${cert_id}.auto_renew=${new_auto_renew}"
	[ -n "${new_account_email}" ] && uci set "nginx_manager.${cert_id}.account_email=${new_account_email}"
	uci set "nginx_manager.${cert_id}.validation_method=${new_validation_method}"
	uci set "nginx_manager.${cert_id}.keylength=${new_keylength}"
	if [ "${new_validation_method}" = "dns" ]; then
		uci set "nginx_manager.${cert_id}.dns_api=${new_dns_api}"
		if [ -n "${new_dns_wait}" ]; then
			uci set "nginx_manager.${cert_id}.dns_wait=${new_dns_wait}"
		else
			uci -q delete "nginx_manager.${cert_id}.dns_wait" 2>/dev/null
		fi
	else
		uci -q delete "nginx_manager.${cert_id}.dns_api" 2>/dev/null
		uci -q delete "nginx_manager.${cert_id}.dns_wait" 2>/dev/null
	fi
	local acme_cmd="$(_acme_build_issue_cmd "${new_domain}" "${new_account_email}" "${new_validation_method}" "${new_dns_api}" "${new_dns_wait}" "${new_keylength}")"
	uci set "nginx_manager.${cert_id}.acme_command=${acme_cmd}"
	uci commit nginx_manager

	# Update acme UCI
	if [ -n "${account_email}" ]; then
		ensure_acme_account_config "${new_account_email}"
	fi
	if uci -q get "acme.${cert_id}" >/dev/null 2>&1; then
		uci set "acme.${cert_id}.validation_method=${new_validation_method}"
		local acme_key_type="ec256"
		case "${new_keylength}" in
			ec384|ec-384) acme_key_type="ec384" ;;
			rsa2048|2048) acme_key_type="rsa2048" ;;
			rsa4096|4096) acme_key_type="rsa4096" ;;
			*) acme_key_type="ec256" ;;
		esac
		uci set "acme.${cert_id}.key_type=${acme_key_type}"
		uci -q delete "acme.${cert_id}.dns" 2>/dev/null
		uci -q delete "acme.${cert_id}.dns_wait" 2>/dev/null
		if [ "${new_validation_method}" = "dns" ]; then
			uci set "acme.${cert_id}.dns=${new_dns_api}"
			if [ -n "${credentials}" ]; then
				uci -q delete "acme.${cert_id}.credentials" 2>/dev/null
				printf '%s\n' "${credentials}" | while IFS= read -r credential_line; do
					credential_line="$(printf '%s' "${credential_line}" | tr -d '\r')"
					[ -z "${credential_line}" ] && continue
					validate_acme_credential "${credential_line}" || exit 1
					uci add_list "acme.${cert_id}.credentials=${credential_line}"
				done || { json_init; json_add_string "error" "invalid dns credentials"; json_dump; return; }
			fi
			[ -n "${new_dns_wait}" ] && uci set "acme.${cert_id}.dns_wait=${new_dns_wait}"
		else
			uci -q delete "acme.${cert_id}.credentials" 2>/dev/null
		fi
		uci delete "acme.${cert_id}.domains" 2>/dev/null
		uci add_list "acme.${cert_id}.domains=${new_domain}"
	fi
	uci commit acme

	json_init
	json_add_string "id" "${cert_id}"
	json_add_string "needs_reissue" "${needs_reissue}"
	json_dump
}

handle_acme_renew() {
	local cert_id disable_auto_renew

	json_get_var cert_id "id"
	json_get_var disable_auto_renew "disable_auto_renew"

	[ -z "${cert_id}" ] && { json_init; json_add_string "error" "missing id"; json_dump; return; }
	validate_uci_id "${cert_id}" || { json_init; json_add_string "error" "invalid id"; json_dump; return; }
	case "${disable_auto_renew}" in
		''|0|1) ;;
		*) { json_init; json_add_string "error" "invalid auto renew"; json_dump; return; } ;;
	esac

	# Prevent concurrent ACME operations for the same cert
	_acme_task_is_running "${cert_id}" && {
		json_init; json_add_string "error" "ACME operation already in progress for this certificate"; json_dump; return
	}

	load_global_config

	# Check if acme package is installed
	if [ ! -x /etc/init.d/acme ]; then
		json_init
		json_add_string "error" "acme package not installed"
		json_dump
		return
	fi

	# Verify cert exists in nginx_manager
	local cert_type domain validation_method auto_renew keylength
	cert_type="$(uci -q get "nginx_manager.${cert_id}.type")" || {
		json_init; json_add_string "error" "cert not found"; json_dump; return
	}
	domain="$(uci -q get "nginx_manager.${cert_id}.domain")" || domain=""
	validation_method="$(uci -q get "nginx_manager.${cert_id}.validation_method")" || validation_method="$(uci -q get "acme.${cert_id}.validation_method" 2>/dev/null)"
	[ -z "${validation_method}" ] && validation_method="webroot"
	auto_renew="$(uci -q get "nginx_manager.${cert_id}.auto_renew")" || auto_renew="1"
	[ "${disable_auto_renew}" = "1" ] && auto_renew="0"
	keylength="$(uci -q get "nginx_manager.${cert_id}.keylength")" || keylength="ec-256"

	if [ "${cert_type}" != "acme" ]; then
		json_init
		json_add_string "error" "not an acme certificate"
		json_dump
		return
	fi
	[ -z "${domain}" ] && { json_init; json_add_string "error" "missing domain"; json_dump; return; }
	case "${validation_method}" in
		webroot|dns|standalone) ;;
		*) { json_init; json_add_string "error" "invalid acme validation method"; json_dump; return; } ;;
	esac
	if { [ "${validation_method}" = "webroot" ] || [ "${validation_method}" = "standalone" ]; } && echo "${domain}" | grep -q '\*'; then
		json_init; json_add_string "error" "wildcard domains not supported for http acme"; json_dump; return
	fi

	# Verify cert exists in acme config
	uci -q get "acme.${cert_id}" >/dev/null 2>&1 || {
		json_init; json_add_string "error" "acme config not found"; json_dump; return
	}

	# Ensure it's enabled
	uci set "acme.${cert_id}.enabled=1"
	uci commit acme
	uci set "nginx_manager.${cert_id}.auto_renew=${auto_renew}"
	uci commit nginx_manager

	local cert_name dns_api dns_wait
	cert_name="$(uci -q get "nginx_manager.${cert_id}.name")" || cert_name="${cert_id}"
	dns_api="$(uci -q get "nginx_manager.${cert_id}.dns_api")" || dns_api=""
	dns_wait="$(uci -q get "nginx_manager.${cert_id}.dns_wait")" || dns_wait=""
	local acme_cmd="$(_acme_build_renew_cmd "${domain}" "${validation_method}" "${dns_api}" "${dns_wait}" "${keylength}")"

	if [ "${validation_method}" = "webroot" ]; then
		local challenge_output
		challenge_output="$(prepare_acme_challenge_config "${cert_id}" "${domain}" 2>&1)"
		if [ $? -ne 0 ]; then
			_acme_restore_enabled "${cert_id}" "${auto_renew}"
			_acme_cert_set_status "${cert_id}" "failed" "${challenge_output}" "${acme_cmd}"
			_acme_task_write_status "${cert_id}" "failed" "${challenge_output}" "${acme_cmd}"

			json_init
			json_add_string "task_id" "${cert_id}"
			json_add_string "status" "failed"
			json_dump
			return
		fi
	fi

	# Write initial status and spawn background worker
	_acme_cert_set_status "${cert_id}" "running" "" "${acme_cmd}"
	_acme_task_write_status "${cert_id}" "running" "ACME is running in the background" "${acme_cmd}"
	(_acme_renew_worker "${cert_id}" "${domain}" "${validation_method}" "${auto_renew}" &)

	json_init
	json_add_string "task_id" "${cert_id}"
	json_add_string "status" "running"
	json_dump
}

handle_acme_status() {
	local task_id
	json_get_var task_id "task_id"

	[ -z "${task_id}" ] && { json_init; json_add_string "error" "missing task_id"; json_dump; return; }
	validate_uci_id "${task_id}" || { json_init; json_add_string "error" "invalid task_id"; json_dump; return; }

	local task_file="/tmp/acme-task-${task_id}.json"
	local status detail command recent_log task_json

	if [ -f "${task_file}" ]; then
		task_json="$(cat "${task_file}")"
		json_load "${task_json}" >/dev/null 2>&1
		json_get_var status "status"
		json_get_var detail "detail"
		json_get_var command "command"
	else
		status="$(uci -q get "nginx_manager.${task_id}.acme_status")" || status="unknown"
		detail="$(uci -q get "nginx_manager.${task_id}.acme_detail")" || detail=""
		command="$(uci -q get "nginx_manager.${task_id}.acme_command")" || command=""
	fi

	[ -z "${status}" ] && status="unknown"
	[ -z "${command}" ] && command="acme.sh --issue -d ${task_id}"
	recent_log="$(_acme_recent_log "${task_id}")"

	json_init
	json_add_string "status" "${status}"
	json_add_string "command" "${command}"
	[ -n "${detail}" ] && json_add_string "detail" "${detail}"
	[ -n "${recent_log}" ] && json_add_string "log" "${recent_log}"
	json_dump
}

handle_scan_acme_certs() {
	load_global_config
	config_load nginx_manager

	json_init
	json_add_array "certificates"

	local cert_file domain key_file expiry_days expiry_date is_linked linked_id linked_name
	local dir

	# OpenWrt's acme package exposes its usable certificate/key pairs here.
	# Other acme.sh working directories may contain the same files repeatedly.
	for dir in /etc/ssl/acme; do
		[ -d "${dir}" ] || continue
		for cert_file in "${dir}"/*.fullchain.crt; do
			[ -f "${cert_file}" ] || continue

			domain=""
			key_file=""
			case "${cert_file}" in
				*.fullchain.crt)
					domain="$(basename "${cert_file}" .fullchain.crt)"
					key_file="${dir}/${domain}.key"
					;;
			esac

			[ -z "${domain}" ] && continue

			expiry_days="$(get_cert_expiry "${cert_file}")" || expiry_days="-1"
			expiry_date="$(openssl x509 -enddate -noout -in "${cert_file}" 2>/dev/null | cut -d= -f2)"

			_SCAN_MATCHED_CERT_ID=""
			_SCAN_MATCHED_CERT_NAME=""
			_SCAN_TARGET_CERT_PATH="${cert_file}"
			_SCAN_TARGET_DOMAIN="${domain}"
			config_foreach _check_scan_linked cert

			is_linked="0"
			linked_id=""
			linked_name=""
			if [ -n "${_SCAN_MATCHED_CERT_ID}" ]; then
				is_linked="1"
				linked_id="${_SCAN_MATCHED_CERT_ID}"
				linked_name="${_SCAN_MATCHED_CERT_NAME}"
			fi

			local scan_acme_sec scan_val_method="" scan_dns_api=""
			scan_acme_sec="$(_find_acme_section_for_domain "${domain}" "")"
			if [ -n "${scan_acme_sec}" ]; then
				scan_val_method="$(uci -q get "acme.${scan_acme_sec}.validation_method")" || scan_val_method=""
				scan_dns_api="$(uci -q get "acme.${scan_acme_sec}.dns")" || scan_dns_api=""
				[ -z "${scan_val_method}" ] && [ -n "${scan_dns_api}" ] && scan_val_method="dns"
				[ -z "${scan_val_method}" ] && scan_val_method="webroot"
			fi

			json_add_object ""
			json_add_string "domain" "${domain}"
			json_add_string "cert_path" "${cert_file}"
			json_add_string "key_path" "${key_file}"
			json_add_string "expiry_days" "${expiry_days}"
			json_add_string "expiry_date" "${expiry_date}"
			json_add_string "is_linked" "${is_linked}"
			json_add_string "linked_cert_id" "${linked_id}"
			json_add_string "linked_cert_name" "${linked_name}"
			[ -n "${scan_val_method}" ] && json_add_string "validation_method" "${scan_val_method}"
			[ -n "${scan_dns_api}" ] && json_add_string "dns_api" "${scan_dns_api}"
			json_close_object
		done
	done

	json_close_array
	json_dump
}

_SCAN_MATCHED_CERT_ID=""
_SCAN_MATCHED_CERT_NAME=""
_SCAN_TARGET_CERT_PATH=""
_SCAN_TARGET_DOMAIN=""
_check_scan_linked() {
	local sec="$1"
	local cp real_cp real_target
	cp="$(uci -q get "nginx_manager.${sec}.cert_path")" || cp=""

	if [ -n "${cp}" ]; then
		if [ "${cp}" = "${_SCAN_TARGET_CERT_PATH}" ]; then
			_SCAN_MATCHED_CERT_ID="${sec}"
			_SCAN_MATCHED_CERT_NAME="$(uci -q get "nginx_manager.${sec}.name")" || _SCAN_MATCHED_CERT_NAME="${sec}"
			return 0
		fi
		real_cp="$(readlink -f "${cp}" 2>/dev/null)"
		real_target="$(readlink -f "${_SCAN_TARGET_CERT_PATH}" 2>/dev/null)"
		if [ -n "${real_cp}" ] && [ -n "${real_target}" ] && [ "${real_cp}" = "${real_target}" ]; then
			_SCAN_MATCHED_CERT_ID="${sec}"
			_SCAN_MATCHED_CERT_NAME="$(uci -q get "nginx_manager.${sec}.name")" || _SCAN_MATCHED_CERT_NAME="${sec}"
			return 0
		fi
	fi
}

handle_import_acme_cert() {
	local cert_name domain cert_path key_path cert_id
	json_get_var cert_name "id"
	json_get_var domain "domain"
	json_get_var cert_path "cert_path"
	json_get_var key_path "key_path"

	[ -z "${cert_name}" ] && { json_init; json_add_string "error" "missing id"; json_dump; return; }
	validate_name "${cert_name}" || { json_init; json_add_string "error" "invalid id"; json_dump; return; }
	[ -z "${domain}" ] && { json_init; json_add_string "error" "missing domain"; json_dump; return; }
	validate_domain "${domain}" || { json_init; json_add_string "error" "invalid domain"; json_dump; return; }

	resolve_new_cert_id "${cert_name}" || { json_init; json_add_string "error" "${_RESOLVE_CERT_ID_ERROR}"; json_dump; return; }
	cert_id="${_RESOLVED_CERT_ID}"

	# The browser may only choose a path emitted by handle_scan_acme_certs. Do
	# not let a crafted ubus request create links to arbitrary system files.
	is_scanned_acme_cert_path "${cert_path}" || {
		json_init; json_add_string "error" "certificate file not found"; json_dump; return;
	}

	# Derive the key path on the router rather than trusting the RPC argument.
	key_path="$(dirname "${cert_path}")/$(basename "${cert_path}" .fullchain.crt).key"
	[ -f "${key_path}" ] || {
		json_init; json_add_string "error" "private key file not found"; json_dump; return;
	}

	load_global_config
	local cert_subdir="${CERT_DIR}/${cert_id}"
	mkdir -p "${cert_subdir}"
	chmod 700 "${cert_subdir}"

	ln -sf "${cert_path}" "${cert_subdir}/fullchain.pem"
	if [ -n "${key_path}" ] && [ -f "${key_path}" ]; then
		ln -sf "${key_path}" "${cert_subdir}/privkey.pem"
	fi

	local auto_renew="0" validation_method="webroot" dns_api="" dns_wait=""
	local acme_sec
	acme_sec="$(_find_acme_section_for_domain "${domain}" "${cert_id}")"
	if [ -n "${acme_sec}" ]; then
		auto_renew="1"
		local en
		en="$(uci -q get "acme.${acme_sec}.enabled")"
		[ -n "${en}" ] && auto_renew="${en}"
		validation_method="$(uci -q get "acme.${acme_sec}.validation_method")" || validation_method=""
		dns_api="$(uci -q get "acme.${acme_sec}.dns")" || dns_api=""
		dns_wait="$(uci -q get "acme.${acme_sec}.dns_wait")" || dns_wait=""
		[ -z "${validation_method}" ] && [ -n "${dns_api}" ] && validation_method="dns"
		[ -z "${validation_method}" ] && validation_method="webroot"
	elif uci -q get "acme.${cert_id}" >/dev/null 2>&1; then
		auto_renew="1"
	fi

	uci set "nginx_manager.${cert_id}=cert"
	uci set "nginx_manager.${cert_id}.name=${cert_name}"
	uci set "nginx_manager.${cert_id}.type=acme"
	uci set "nginx_manager.${cert_id}.cert_path=${cert_subdir}/fullchain.pem"
	uci set "nginx_manager.${cert_id}.key_path=${cert_subdir}/privkey.pem"
	uci set "nginx_manager.${cert_id}.domain=${domain}"
	uci set "nginx_manager.${cert_id}.auto_renew=${auto_renew}"
	local acme_email
	acme_email="$(_get_acme_account_email "${cert_id}")"
	[ -n "${acme_email}" ] && uci set "nginx_manager.${cert_id}.account_email=${acme_email}"
	uci set "nginx_manager.${cert_id}.validation_method=${validation_method}"
	[ -n "${dns_api}" ] && uci set "nginx_manager.${cert_id}.dns_api=${dns_api}"
	[ -n "${dns_wait}" ] && uci set "nginx_manager.${cert_id}.dns_wait=${dns_wait}"
	uci set "nginx_manager.${cert_id}.acme_status=success"
	uci commit nginx_manager

	json_init
	json_add_string "result" "ok"
	json_add_string "id" "${cert_id}"
	json_dump
}

handle_get_acme_global_config() {
	config_load nginx_manager

	local account_email default_dns_api dns_wait
	account_email="$(_get_acme_account_email)" || account_email=""
	default_dns_api="$(uci -q get nginx_manager.acme_global.default_dns_api)" || default_dns_api="dns_cf"
	dns_wait="$(uci -q get nginx_manager.acme_global.dns_wait)" || dns_wait="120"

	json_init
	json_add_string "account_email" "${account_email}"
	json_add_string "default_dns_api" "${default_dns_api}"
	json_add_string "dns_wait" "${dns_wait}"

	json_add_object "providers"
	local p
	for p in dns_cf dns_dp dns_ali dns_huaweicloud dns_aws dns_gd dns_namecheap; do
		json_add_object "${p}"
		local opt_val opt_key
		for opt_key in CF_Token CF_Account_ID CF_Zone_ID DP_Id DP_Key Ali_Key Ali_Secret HUAWEICLOUD_Username HUAWEICLOUD_Password HUAWEICLOUD_DomainName AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY GD_Key GD_Secret NAMECHEAP_USERNAME NAMECHEAP_API_KEY NAMECHEAP_SOURCEIP; do
			opt_val="$(uci -q get "nginx_manager.acme_dns_${p}.${opt_key}")" || continue
			[ -n "${opt_val}" ] && json_add_string "${opt_key}" "${opt_val}"
		done
		json_close_object
	done
	json_close_object
	json_dump
}

handle_set_acme_global_config() {
	local account_email default_dns_api dns_wait dns_api credentials
	json_get_var account_email "account_email"
	json_get_var default_dns_api "default_dns_api"
	json_get_var dns_wait "dns_wait"
	json_get_var dns_api "dns_api"
	json_get_var credentials "credentials"

	if [ -n "${default_dns_api}" ]; then
		global_dns_provider_keys "${default_dns_api}" >/dev/null || { json_init; json_add_string "error" "invalid dns api"; json_dump; return; }
	fi
	if [ -n "${dns_wait}" ]; then
		validate_positive_number "${dns_wait}" || { json_init; json_add_string "error" "invalid dns wait seconds"; json_dump; return; }
	fi
	if [ -n "${dns_api}" ]; then
		global_dns_provider_keys "${dns_api}" >/dev/null || { json_init; json_add_string "error" "invalid dns api"; json_dump; return; }
		printf '%s\n' "${credentials}" | while IFS= read -r credential_line; do
			credential_line="$(printf '%s' "${credential_line}" | tr -d '\r')"
			[ -z "${credential_line}" ] && continue
			validate_acme_credential "${credential_line}" || exit 1
			local key
			key="${credential_line%%=*}"
			is_global_dns_provider_key "${dns_api}" "${key}" || exit 1
		done || { json_init; json_add_string "error" "invalid dns credentials"; json_dump; return; }
	fi

	uci set nginx_manager.acme_global=acme_global
	if [ -n "${account_email}" ]; then
		validate_acme_account_email "${account_email}" || { json_init; json_add_string "error" "invalid acme account email"; json_dump; return; }
		uci set "nginx_manager.acme_global.account_email=${account_email}"
		ensure_acme_account_config "${account_email}"
	fi
	[ -n "${default_dns_api}" ] && uci set "nginx_manager.acme_global.default_dns_api=${default_dns_api}"
	[ -n "${dns_wait}" ] && uci set "nginx_manager.acme_global.dns_wait=${dns_wait}"

	if [ -n "${dns_api}" ]; then
		local section_name="acme_dns_${dns_api}"
		uci set "nginx_manager.${section_name}=dns_provider"
		local allowed_key
		for allowed_key in $(global_dns_provider_keys "${dns_api}"); do
			uci -q delete "nginx_manager.${section_name}.${allowed_key}" 2>/dev/null
		done
		printf '%s\n' "${credentials}" | while IFS= read -r credential_line; do
			credential_line="$(printf '%s' "${credential_line}" | tr -d '\r')"
			[ -z "${credential_line}" ] && continue
			local key val
			key="${credential_line%%=*}"
			val="${credential_line#*=}"
			uci set "nginx_manager.${section_name}.${key}=${val}"
		done
	fi

	uci commit nginx_manager

	json_init
	json_add_string "result" "ok"
	json_dump
}

