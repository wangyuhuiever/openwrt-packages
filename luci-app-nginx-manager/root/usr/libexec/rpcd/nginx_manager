		return
	}

	if [ -z "${log_paths}" ]; then
		json_init
		json_add_string "error" "log file not found"
		json_dump
		return
	fi

	cleared="0"
	for log_path in ${log_paths}; do
		[ -f "${log_path}" ] || continue
		printf '' > "${log_path}" || {
			json_init
			json_add_string "error" "failed to clear log file"
			json_add_string "path" "${log_path}"
			json_dump
			return
		}
		cleared="1"
	done

	if [ "${cleared}" != "1" ]; then
		json_init
		json_add_string "error" "log file not found"
