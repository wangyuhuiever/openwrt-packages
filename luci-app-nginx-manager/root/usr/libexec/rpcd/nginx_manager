}

handle_clear_all_logs() {
	local cleared=0
	local paths=""
	for log_path in /var/log/nginx/access.log /var/log/nginx/*.access.log \
	                /var/log/nginx/error.log /var/log/nginx/*.error.log; do
		[ -f "${log_path}" ] || continue
		printf '' > "${log_path}" || continue
		paths="${paths:+${paths},}${log_path}"
		cleared=$((cleared + 1))
	done
