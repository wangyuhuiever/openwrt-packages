handle_get_log_size() {
	local log_type site log_paths log_path
	json_get_var log_type "type"
	json_get_var site "site"
	log_paths="$(resolve_log_paths "${log_type}" "${site}")" || {
		json_init; json_add_int "size" 0; json_dump; return
	}
	local total_size=0 sz
	for log_path in ${log_paths}; do
		[ -f "${log_path}" ] || continue
		sz=$(stat -c '%s' "${log_path}" 2>/dev/null) || sz=$(wc -c < "${log_path}" 2>/dev/null) || sz=0
		total_size=$((total_size + sz))
	done
	json_init
	json_add_int "size" "${total_size}"
	json_dump
}

handle_list_files() {
	local dir
	json_get_var dir "dir"
	[ -n "${dir}" ] || dir="/etc/nginx"

	# Resolve and validate: block /proc /sys /dev for safety
	local resolved
	resolved=$(readlink -f "${dir}" 2>/dev/null || realpath "${dir}" 2>/dev/null)
	case "${resolved}" in
		/proc|/proc/*|/sys|/sys/*|/dev|/dev/*)
			json_init; json_add_string "error" "access denied: system directory"; json_dump; return ;;
	esac

	[ -d "${dir}" ] || { json_init; json_add_string "error" "not a directory"; json_dump; return; }

	json_init
	json_add_string "path" "${resolved}"
	json_add_array "entries"
	for entry in "${dir}"/*; do
		[ -e "${entry}" ] || continue
		local basename="${entry##*/}"
		local type="file"
		[ -d "${entry}" ] && type="dir"
		local perms owner group size
		perms=$(stat -c '%a' "${entry}" 2>/dev/null) || perms="???"
		owner=$(stat -c '%U' "${entry}" 2>/dev/null) || owner="?"
		group=$(stat -c '%G' "${entry}" 2>/dev/null) || group="?"
		size=$(stat -c '%s' "${entry}" 2>/dev/null) || size="0"
		json_add_object
		json_add_string "name" "${basename}"
		json_add_string "type" "${type}"
		json_add_string "perms" "${perms}"
		json_add_string "owner" "${owner}"
		json_add_string "group" "${group}"
		json_add_int "size" "${size}"
		json_close_object
	done
	json_close_array
	json_dump
}

handle_save_file() {
	local path content
	json_get_var path "path"
	json_get_var content "content"

	[ -n "${path}" ] || { json_init; json_add_string "error" "path is required"; json_dump; return; }

	# Block system directories
	local resolved
	resolved=$(readlink -f "${path}" 2>/dev/null || realpath "${path}" 2>/dev/null)
	if [ -z "${resolved}" ]; then
		local parent_resolved
		parent_resolved=$(readlink -f "$(dirname "${path}")" 2>/dev/null || realpath "$(dirname "${path}")" 2>/dev/null)
		[ -z "${parent_resolved}" ] && {
			json_init; json_add_string "error" "access denied: invalid path"; json_dump; return
		}
		resolved="${parent_resolved}/$(basename "${path}")"
	fi
	case "${resolved}" in
		/proc|/proc/*|/sys|/sys/*|/dev|/dev/*)
			json_init; json_add_string "error" "access denied: system directory"; json_dump; return ;;
	esac

	# For paths outside /etc/nginx, require dangerous_core_edit
	case "${resolved}" in
		/etc/nginx|/etc/nginx/*) ;;
		*)
			local dangerous
			dangerous="$(uci -q get nginx_manager.global.dangerous_core_edit)" || dangerous="0"
			[ "${dangerous}" = "1" ] || {
				json_init; json_add_string "error" "Dangerous core edit is disabled"; json_dump; return
			}
			;;
	esac

	local backup_output
	backup_output="$("${NGINX_MANAGER_GEN}" backup 2>&1)" || {
		json_init
		json_add_string "error" "backup failed"
		json_add_string "detail" "${backup_output}"
		json_dump
		return
	}

	printf '%s\n' "${content}" > "${path}" || {
		json_init; json_add_string "error" "failed to write file"; json_dump; return
	}

	json_init
	json_add_string "result" "ok"
	json_dump
}

handle_chmod_file() {
	local path perms
	json_get_var path "path"
	json_get_var perms "perms"

	[ -n "${path}" ] || { json_init; json_add_string "error" "path is required"; json_dump; return; }

	local resolved
	resolved=$(readlink -f "${path}" 2>/dev/null || realpath "${path}" 2>/dev/null)
	if [ -z "${resolved}" ]; then
		local parent_resolved
		parent_resolved=$(readlink -f "$(dirname "${path}")" 2>/dev/null || realpath "$(dirname "${path}")" 2>/dev/null)
		[ -z "${parent_resolved}" ] && {
			json_init; json_add_string "error" "access denied: invalid path"; json_dump; return
		}
		resolved="${parent_resolved}/$(basename "${path}")"
	fi
	case "${resolved}" in
		/proc|/proc/*|/sys|/sys/*|/dev|/dev/*)
			json_init; json_add_string "error" "access denied: system directory"; json_dump; return ;;
	esac

	# For paths outside /etc/nginx, require dangerous_core_edit
	case "${resolved}" in
		/etc/nginx|/etc/nginx/*) ;;
		*)
			local dangerous
			dangerous="$(uci -q get nginx_manager.global.dangerous_core_edit)" || dangerous="0"
			[ "${dangerous}" = "1" ] || {
				json_init; json_add_string "error" "Dangerous core edit is disabled"; json_dump; return
			}
			;;
	esac

	# Validate perms is a 3-4 digit octal
	case "${perms}" in
		[0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) ;;
		*) json_init; json_add_string "error" "invalid permissions"; json_dump; return ;;
	esac

	[ -e "${path}" ] || {
		json_init; json_add_string "error" "file not found"; json_dump; return
	}

	chmod "${perms}" "${path}" || {
		json_init; json_add_string "error" "failed to change permissions"; json_dump; return
	}

	json_init
	json_add_string "result" "ok"
	json_dump
}

# Read a directive value from the effective nginx configuration (nginx -T)
_NGINX_T_CACHE=""
_read_nginx_directive() {
	local directive="$1"

	# Cache nginx -T output to avoid running it multiple times
	if [ -z "${_NGINX_T_CACHE}" ]; then
		detect_nginx_conf
		_NGINX_T_CACHE="$(nginx -T -c "${NGINX_CONF_PATH}" 2>/dev/null)" || _NGINX_T_CACHE=""
	fi

	local value=""
	if [ -n "${_NGINX_T_CACHE}" ]; then
		# Search for the directive in http{} top-level context only.
		# These directives appear with minimal indentation (0-4 spaces) inside http{},
		# while server{} and location{} directives have deeper indentation (8+ spaces).
		value="$(printf '%s\n' "${_NGINX_T_CACHE}" | \
			grep -E "^[[:space:]]{0,4}${directive}[[:space:]]+" | head -1 | \
			sed "s/.*${directive}[[:space:]]*//; s/[[:space:]]*;.*//")"
	fi

	# Fallback: search main config files if nginx -T didn't work
	if [ -z "${value}" ]; then
		local conf_files="/etc/nginx/uci.conf.template /etc/nginx/nginx.conf"
		for conf_file in ${conf_files}; do
			[ -f "${conf_file}" ] || continue
			value="$(grep -E "^[[:space:]]*${directive}[[:space:]]+" "${conf_file}" 2>/dev/null | head -1 | sed "s/.*${directive}[[:space:]]*//; s/[[:space:]]*;.*//")"
			[ -n "${value}" ] && break
		done
	fi

	echo "${value}"
}

handle_get_core_config() {
	load_global_config

	# Read nginx -T once for a fresh effective-config snapshot.
	detect_nginx_conf
	_NGINX_T_CACHE="$(nginx -T -c "${NGINX_CONF_PATH}" 2>/dev/null)" || _NGINX_T_CACHE="# nginx -T unavailable"

	local gzip_val sendfile_val server_tokens_val
	local max_body_val keepalive_val access_log_val error_log_val
	local ssl_session_timeout_val ssl_session_cache_val ssl_session_tickets_val ssl_stapling_val ssl_buffer_size_val _val

	# Prefer the effective nginx configuration so the UI reflects what is
	# currently enabled after nginx has expanded its includes.
	_val="$(_read_nginx_directive client_max_body_size)"
	max_body_val="${_val}"
	_val="$(_read_nginx_directive keepalive_timeout)"
	keepalive_val="${_val}"
	_val="$(_read_nginx_directive gzip)"
	case "${_val}" in
		on) gzip_val="1" ;;
		off) gzip_val="0" ;;
		*) gzip_val="" ;;
	esac
	_val="$(_read_nginx_directive server_tokens)"
	case "${_val}" in
		on|off) server_tokens_val="${_val}" ;;
		*) server_tokens_val="" ;;
	esac
	_val="$(_read_nginx_directive sendfile)"
	case "${_val}" in
		on) sendfile_val="1" ;;
		off) sendfile_val="0" ;;
		*) sendfile_val="" ;;
	esac
	_val="$(_read_nginx_directive access_log)"
	access_log_val="${_val}"
	_val="$(_read_nginx_directive error_log)"
	error_log_val="${_val}"
	_val="$(_read_nginx_directive ssl_session_timeout)"
	ssl_session_timeout_val="${_val}"
	_val="$(_read_nginx_directive ssl_session_cache)"
	ssl_session_cache_val="${_val}"
	_val="$(_read_nginx_directive ssl_session_tickets)"
	case "${_val}" in
		on) ssl_session_tickets_val="1" ;;
		off) ssl_session_tickets_val="0" ;;
		*) ssl_session_tickets_val="" ;;
	esac
	ssl_stapling_val="$(uci -q get nginx_manager.global.ssl_stapling || true)"
	_val="$(_read_nginx_directive ssl_buffer_size)"
	ssl_buffer_size_val="${_val}"

	# Fall back to UCI when nginx -T is unavailable or the directive is absent.
	[ -z "${max_body_val}" ] && max_body_val="$(uci -q get nginx_manager.global.client_max_body_size || true)"
	[ -z "${keepalive_val}" ] && keepalive_val="$(uci -q get nginx_manager.global.keepalive_timeout || true)"
	[ -z "${gzip_val}" ] && gzip_val="$(uci -q get nginx_manager.global.gzip || true)"
	[ -z "${server_tokens_val}" ] && server_tokens_val="$(uci -q get nginx_manager.global.server_tokens || true)"
	[ -z "${sendfile_val}" ] && sendfile_val="$(uci -q get nginx_manager.global.sendfile || true)"
	[ -z "${access_log_val}" ] && access_log_val="$(uci -q get nginx_manager.global.access_log || true)"
	[ -z "${error_log_val}" ] && error_log_val="$(uci -q get nginx_manager.global.error_log || true)"
	[ -z "${ssl_session_timeout_val}" ] && ssl_session_timeout_val="$(uci -q get nginx_manager.global.ssl_session_timeout || true)"
	[ -z "${ssl_session_cache_val}" ] && ssl_session_cache_val="$(uci -q get nginx_manager.global.ssl_session_cache || true)"
	[ -z "${ssl_session_tickets_val}" ] && ssl_session_tickets_val="$(uci -q get nginx_manager.global.ssl_session_tickets || true)"
	[ -z "${ssl_stapling_val}" ] && ssl_stapling_val="1"
	[ -z "${ssl_buffer_size_val}" ] && ssl_buffer_size_val="$(uci -q get nginx_manager.global.ssl_buffer_size || true)"

	json_init
	json_add_string "client_max_body_size" "${max_body_val}"
	json_add_string "keepalive_timeout" "${keepalive_val}"
	json_add_string "gzip" "${gzip_val}"
	json_add_string "server_tokens" "${server_tokens_val}"
	json_add_string "sendfile" "${sendfile_val}"
	json_add_string "access_log" "${access_log_val}"
	json_add_string "error_log" "${error_log_val}"
	json_add_string "ssl_session_timeout" "${ssl_session_timeout_val}"
	json_add_string "ssl_session_cache" "${ssl_session_cache_val}"
	json_add_string "ssl_session_tickets" "${ssl_session_tickets_val}"
	json_add_string "ssl_stapling" "${ssl_stapling_val}"
	json_add_string "ssl_buffer_size" "${ssl_buffer_size_val}"
	json_add_string "custom_ssl_directives" "$(uci -q get nginx_manager.global.custom_ssl_directives || true)"
	json_add_string "advanced_mode" "$(uci -q get nginx_manager.global.advanced_mode || echo '0')"
	json_add_string "security_headers" "$(uci -q get nginx_manager.global.security_headers || echo '1')"
	json_add_string "dangerous_core_edit" "$(uci -q get nginx_manager.global.dangerous_core_edit || echo '0')"
	json_dump
}

handle_sync_core_from_nginx() {
	local initialized
	initialized="$(uci -q get nginx_manager.global.core_config_initialized)" || initialized="0"

	if [ "${initialized}" = "1" ]; then
		json_init
		json_add_string "result" "ok"
		json_add_string "synced" "0"
		json_dump
		return
	fi

	load_global_config
	detect_nginx_conf
	_NGINX_T_CACHE="$(nginx -T -c "${NGINX_CONF_PATH}" 2>/dev/null)" || _NGINX_T_CACHE=""

	local nginx_val

	# Sync nginx directive values to UCI
	for field in client_max_body_size keepalive_timeout access_log error_log ssl_session_timeout ssl_session_cache ssl_buffer_size; do
		nginx_val="$(_read_nginx_directive "${field}")"
		if [ -n "${nginx_val}" ]; then
			uci set "nginx_manager.global.${field}=${nginx_val}"
		fi
	done

	# Handle boolean-like directives
	nginx_val="$(_read_nginx_directive "gzip")"
	case "${nginx_val}" in
		on)  uci set "nginx_manager.global.gzip=1" ;;
		off) uci set "nginx_manager.global.gzip=0" ;;
	esac

	nginx_val="$(_read_nginx_directive "sendfile")"
	case "${nginx_val}" in
		on)  uci set "nginx_manager.global.sendfile=1" ;;
		off) uci set "nginx_manager.global.sendfile=0" ;;
	esac

	nginx_val="$(_read_nginx_directive "tcp_nopush")"
	case "${nginx_val}" in
		on)  uci set "nginx_manager.global.tcp_nopush=1" ;;
		off) uci set "nginx_manager.global.tcp_nopush=0" ;;
	esac

	nginx_val="$(_read_nginx_directive "tcp_nodelay")"
	case "${nginx_val}" in
		on)  uci set "nginx_manager.global.tcp_nodelay=1" ;;
		off) uci set "nginx_manager.global.tcp_nodelay=0" ;;
	esac

	nginx_val="$(_read_nginx_directive "ssl_session_tickets")"
	case "${nginx_val}" in
		on)  uci set "nginx_manager.global.ssl_session_tickets=1" ;;
		off) uci set "nginx_manager.global.ssl_session_tickets=0" ;;
	esac

	# Handle server_tokens
	nginx_val="$(_read_nginx_directive "server_tokens")"
	case "${nginx_val}" in
		on|off) uci set "nginx_manager.global.server_tokens=${nginx_val}" ;;
	esac

	# Mark as initialized
	# Set security_headers default if not already configured
	uci -q get nginx_manager.global.security_headers >/dev/null 2>&1 || \
		uci set "nginx_manager.global.security_headers=1"
	uci set "nginx_manager.global.core_config_initialized=1"
	uci commit nginx_manager

	json_init
	json_add_string "result" "ok"
	json_add_string "synced" "1"
	json_dump
}

custom_ssl_directive_conflicts() {
	local custom_ssl_directives ssl_session_cache ssl_stapling ssl_buffer_size
	local managed_zone managed_size managed_directives

	custom_ssl_directives="$(uci -q get nginx_manager.global.custom_ssl_directives)" || custom_ssl_directives=""
	[ -n "${custom_ssl_directives}" ] || return 0

	ssl_session_cache="$(uci -q get nginx_manager.global.ssl_session_cache)" || ssl_session_cache=""
	[ -z "${ssl_session_cache}" ] && ssl_session_cache="shared:SSL:10m"
	managed_zone="$(printf '%s\n' "${ssl_session_cache}" | sed -n 's/.*shared:\([^:;[:space:]]*\):\([^;[:space:]]*\).*/\1/p')"
	managed_size="$(printf '%s\n' "${ssl_session_cache}" | sed -n 's/.*shared:\([^:;[:space:]]*\):\([^;[:space:]]*\).*/\2/p')"

	ssl_stapling="$(uci -q get nginx_manager.global.ssl_stapling)" || ssl_stapling="1"
	ssl_buffer_size="$(uci -q get nginx_manager.global.ssl_buffer_size)" || ssl_buffer_size=""
	local security_headers
	security_headers="$(uci -q get nginx_manager.global.security_headers)" || security_headers="1"

	managed_directives="ssl_certificate ssl_certificate_key ssl_protocols ssl_ciphers ssl_prefer_server_ciphers ssl_session_timeout ssl_session_tickets ssl_trusted_certificate http2"
	[ -n "${ssl_buffer_size}" ] && managed_directives="${managed_directives} ssl_buffer_size"
	if [ "${ssl_stapling}" = "1" ]; then
		managed_directives="${managed_directives} ssl_stapling ssl_stapling_verify resolver resolver_timeout"
	fi

	local _CUSTOM_SSL_LINE_NO=0
	printf '%s\n' "${custom_ssl_directives}" | while IFS= read -r line; do
		_CUSTOM_SSL_LINE_NO=$((_CUSTOM_SSL_LINE_NO + 1))
		local trimmed directive custom_zone custom_size

		trimmed="$(printf '%s\n' "${line}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
		case "${trimmed}" in
			''|\#*) continue ;;
		esac

		directive="$(printf '%s\n' "${line}" | sed -n 's/^[[:space:]]*\([A-Za-z0-9_][A-Za-z0-9_]*\)\([[:space:];].*\)\{0,1\}$/\1/p')"
		[ -n "${directive}" ] || continue

		if [ "${directive}" = "ssl_session_cache" ] && [ -n "${managed_zone}" ]; then
			custom_zone="$(printf '%s\n' "${line}" | sed -n 's/.*shared:\([^:;[:space:]]*\):\([^;[:space:]]*\).*/\1/p')"
			custom_size="$(printf '%s\n' "${line}" | sed -n 's/.*shared:\([^:;[:space:]]*\):\([^;[:space:]]*\).*/\2/p')"
			if [ -n "${custom_zone}" ] && [ "${custom_zone}" = "${managed_zone}" ] && [ "${custom_size}" != "${managed_size}" ]; then
				printf 'Line %s: ssl_session_cache reuses shared zone "%s" with size %s, but SSL Session Cache uses %s. Use a different zone name or change the SSL Session Cache field.\n' \
					"${_CUSTOM_SSL_LINE_NO}" "${custom_zone}" "${custom_size}" "${ssl_session_cache}"
			fi
			continue
		fi

		# Check add_header conflicts with managed headers
		if [ "${directive}" = "add_header" ]; then
			local header_name
			header_name="$(printf '%s\n' "${line}" | sed -n 's/^[[:space:]]*add_header[[:space:]]\+\([^[:space:];"'"'"']*\).*/\1/p')"
			case "${header_name}" in
				Strict-Transport-Security)
					printf 'Line %s: "add_header Strict-Transport-Security" is managed by HSTS settings. Set HSTS Max Age to 0 to disable it.\n' \
						"${_CUSTOM_SSL_LINE_NO}"
					;;
				Alt-Svc)
					printf 'Line %s: "add_header Alt-Svc" is managed by HTTP/3 settings. Disable HTTP/3 to customize it.\n' \
						"${_CUSTOM_SSL_LINE_NO}"
					;;
				X-Frame-Options|Content-Security-Policy|X-Content-Type-Options|Referrer-Policy)
					if [ "${security_headers}" = "1" ]; then
						printf 'Line %s: "add_header %s" is managed by Security Headers. Disable Security Headers to customize it.\n' \
							"${_CUSTOM_SSL_LINE_NO}" "${header_name}"
					fi
					;;
			esac
			continue
		fi

		case " ${managed_directives} " in
			*" ${directive} "*)
				printf 'Line %s: "%s" is already managed by Nginx Manager. Remove this line from Custom SSL Directives and use the dedicated field instead.\n' \
					"${_CUSTOM_SSL_LINE_NO}" "${directive}"
				;;
		esac
	done
}

