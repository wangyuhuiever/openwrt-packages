handle_set_cert() {
	local cert_id name type cert_path key_path domain auto_renew

	json_get_var cert_id "id"
	json_get_var name "name"
	json_get_var type "type"
	json_get_var cert_path "cert_path"
	json_get_var key_path "key_path"
	json_get_var domain "domain"
	json_get_var auto_renew "auto_renew"

	[ -z "${cert_id}" ] && { json_init; json_add_string "error" "missing id"; json_dump; return; }
	validate_uci_id "${cert_id}" || { json_init; json_add_string "error" "invalid id"; json_dump; return; }

	# Verify it's actually a cert section (prevent overwriting site sections)
	local _existing_type
	_existing_type="$(uci -q get "nginx_manager.${cert_id}")" || _existing_type=""
	if [ -n "${_existing_type}" ] && [ "${_existing_type}" != "cert" ]; then
		json_init; json_add_string "error" "name conflicts with an existing ${_existing_type} (resolved to ${cert_id})"; json_dump; return
	fi

	uci set "nginx_manager.${cert_id}=cert"
	[ -n "${name}" ] && uci set "nginx_manager.${cert_id}.name=${name}"
	[ -n "${type}" ] && uci set "nginx_manager.${cert_id}.type=${type}"
	[ -n "${cert_path}" ] && uci set "nginx_manager.${cert_id}.cert_path=${cert_path}"
	[ -n "${key_path}" ] && uci set "nginx_manager.${cert_id}.key_path=${key_path}"
	[ -n "${domain}" ] && uci set "nginx_manager.${cert_id}.domain=${domain}"
	[ -n "${auto_renew}" ] && uci set "nginx_manager.${cert_id}.auto_renew=${auto_renew}"

	uci commit nginx_manager

	json_init
	json_add_string "result" "ok"
	json_dump
}

