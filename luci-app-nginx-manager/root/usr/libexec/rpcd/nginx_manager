_find_acme_section_for_domain() {
	local target_domain="$1" cert_id="$2"
	local sec d

	# 1. Direct section name match in acme config
	if [ -n "${cert_id}" ] && uci -q get "acme.${cert_id}" >/dev/null 2>&1; then
		echo "${cert_id}"
		return 0
	fi

	# 2. Section name without cert_ prefix
	local stripped_id="${cert_id#cert_}"
	if [ -n "${stripped_id}" ] && uci -q get "acme.${stripped_id}" >/dev/null 2>&1; then
		echo "${stripped_id}"
		return 0
	fi

	# 3. Match domain in domains list
	for sec in $(uci show acme 2>/dev/null | grep -E '^acme\.[^.]+=cert$' | cut -d. -f2 | cut -d= -f1); do
		for d in $(uci -q get "acme.${sec}.domains"); do
			if [ "${d}" = "${target_domain}" ]; then
				echo "${sec}"
				return 0
			fi
		done
	done

	return 1
}

_get_acme_account_email() {
	local cert_id="$1"
	local email

	# 1. From the certificate's own named section in nginx_manager
	if [ -n "${cert_id}" ]; then
		email="$(uci -q get "nginx_manager.${cert_id}.account_email")" || email=""
		[ -n "${email}" ] && { echo "${email}"; return 0; }
	fi

	# 2. From nginx_manager global setting (named node nginx_manager.acme_global)
	email="$(uci -q get nginx_manager.acme_global.account_email)" || email=""
	[ -n "${email}" ] && { echo "${email}"; return 0; }

	# 3. From acme config named section (acme.acme)
	email="$(uci -q get acme.acme.account_email)" || email=""
	[ -n "${email}" ] && { echo "${email}"; return 0; }

	# 4. From acme config anonymous section (acme.@acme[0])
	email="$(uci -q get acme.@acme[0].account_email)" || email=""
	[ -n "${email}" ] && { echo "${email}"; return 0; }

	# 5. From any other acme section in /etc/config/acme
	local sec
	for sec in $(uci show acme 2>/dev/null | grep -E '^acme\.[^.]+=acme$' | cut -d. -f2 | cut -d= -f1); do
		email="$(uci -q get "acme.${sec}.account_email")"
		[ -n "${email}" ] && { echo "${email}"; return 0; }
	done

	return 1
}

